<?xml version="1.0" encoding="UTF-8"?>
<div type="attributeDocumentation" xml:id="attr-functionType" xmlns:ead="https://archivists.org/ns/ead/v4" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:xlink="http://www.w3c.org/1999/xlink">
	<head>
		<att>functionType</att>
	</head>
	<div type="fullName">
		<p>Function Type</p>
	</div>
	<div type="summary">
		<p>An optional attribute of <gi>function</gi> that specifies the type of function being described.</p>
	</div>
	<div type="description">
		<p>Use <att>functionType</att> with <gi>function</gi> to specify the type of function being described.</p>
		<p>Use the attribute <att>functionTypeEncoding</att> in <gi>control</gi> to identify the list of authoritative terms that can be used as values of <att>functionType</att>.</p>
	</div>
	<div type="datatype">
		<p>token</p>
	</div>

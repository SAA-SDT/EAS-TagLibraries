<?xml version="1.0" encoding="UTF-8"?>
<div xmlns:ead="https://archivists.org/ns/ead/v4" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:xlink="http://www.w3c.org/1999/xlink" type="elementDocumentation" xml:id="elem-unitTitle">
	<head>
		<gi>unitTitle</gi>
	</head>
	<div type="fullName">
		<p>Title of the Unit</p>
	</div>
	<div type="summary">
		<p>A child element of <gi>identificationData</gi> that specifies a title for the described materials.</p>
	</div>
	<div type="mayContain">
		<p><list type="gloss">
  <label>[text]</label>
  <item/>
  <label>reference</label>
  <item>0..n</item>
  <label>referringString</label>
  <item>0..n</item>
  <label>span</label>
  <item>0..n</item>
</list></p>
	</div>
	<div type="mayOccurWithin">
		<p>identificationData</p>
	</div>
	<div type="attributes">
                  <p>
                     <list type="gloss">
                        <label>audience</label>
                        <item>Optional</item>
                        <label>conventionDeclarationReference</label>
                        <item>Optional</item>
                        <label>id</label>
                        <item>Optional</item>
                        <label>languageOfElement</label>
                        <item>Optional</item>
                        <label>localType</label>
                        <item>Optional</item>
                        <label>localTypeDeclarationReference</label>
                        <item>Optional</item>
                        <label>maintenanceEventReference</label>
                        <item>Optional</item>
                        <label>scriptOfElement</label>
                        <item>Optional</item>
                        <label>sourceReference</label>
                        <item>Optional</item>
                        <label>target</label>
                        <item>Optional</item>
                        <label>valueURI</label>
                        <item>Optional</item>
                        <label>vocabularySource</label>
                        <item>Optional</item>
                        <label>vocabularySourceURI</label>
                        <item>Optional</item>
                     </list>
                  </p>
        </div>
	<div type="description">
		<p><gi>unitTitle</gi> is for recording the title statement, either formal or supplied, of the described materials. The title statement may consist of a word or phrase. <gi>unitTitle</gi> is used at both the highest unit or <gi>archDesc</gi> level (e.g., collection, record set, or fonds) and at all the subordinate <gi>c</gi> levels (e.g., subseries, files, records, items, or other intervening stages within a hierarchical description).</p>
	</div>
	<div type="attributeusage"><p>Use <att>localType</att> if local use requires recording the type of <gi>unitTitle</gi>.</p></div>	
	<div type="availability">
		<p>Optional, repeatable</p>
	</div>
	<div type="examples">
		<egXML xmlns="http://www.tei-c.org/ns/Examples">
			<![CDATA[<c>
			<identificationData>
			<unitTitle>Manouche</unitTitle>
		</identificationData>
			<c>
			<identificationData>
			<unitTitle>Recording</unitTitle>
			<unitId>grove_005</unitId>
			<container localType="Box" localTypeDeclarationReference="containers">559</container>
		</identificationData>
			<scopeContent>
			<p>45-rpm phonodisc of Manouche singing two unidentified French songs</p>
		</scopeContent>
		</c>
			[...]
		</c>]]>
		</egXML>
		<egXML xmlns="http://www.tei-c.org/ns/Examples">
			<![CDATA[<c level="subseries">
			<identificationData>
			<unitTitle>Documentary Movies</unitTitle>
			<unitDate unitDateType="inclusive">
			<dateRange>
			<fromDate>1952</fromDate>
			<toDate>1964</toDate>
		</dateRange>
		</unitDate>
			<extent>
			<quantity>2.5</quantity>
			<unitOfMeasurement>linear ft.</unitOfMeasurement>
		</extent>
		</identificationData>
			<scopeContent>
			<p>Includes scores, arranged alphabetically by movie title, and some correspondence, arranged chronologically.</p>
		</scopeContent>
		</c>]]>
		</egXML>
		<egXML xmlns="http://www.tei-c.org/ns/Examples">
			<![CDATA[<archDesc level="collection">
			<identificationData>
			<unitTitle>Donald C. Stone, Jr. Papers</unitTitle>
			<unitDate unitDateType="inclusive">
			<dateRange>
			<fromDate>1971</fromDate>
			<toDate>1983</toDate>
		</dateRange>
		</unitDate>
			<unitId countryCode="US" repositoryCode="cbgtu"
			valueURI="https://library.syracuse.edu/digital/guides/s/stone_dc.htm" localType="accessionNumber" localTypeDeclarationReference="identifiers">GTU 2001-08-03</unitId>
			<extent extentType="carrier" coverage="whole">
			<quantity>4</quantity>
			<unitOfMeasurement>boxes</unitOfMeasurement>
		</extent>
			<extent extentType="spaceOccupied" coverage="whole">
			<quantity>4</quantity>
			<unitOfMeasurement>linear ft.</unitOfMeasurement>
		</extent>
		</identificationData>
			<agents>
			<agent agentType="person" valueURI="http://id.loc.gov/authorities/names/n80148920" vocabularySource="LCNAF">
			<label>Stone, Donald C., Jr.</label>
			<role>Creator</role>
		</agent>
			<agent agentType="group" valueURI="http://id.loc.gov/authorities/names/n79126342" vocabularySource="LCNAF">
			<label>The Graduate Theological Union</label>
			<role>holdingInstitution</role>
		</agent>
		</agents>
			<places>
			<place placeType="repository">
			<label>Flora Lamson Hewlett Library</label>
			<address>
			<addressLine>Berkeley, California</addressLine>
		</address>
		</place>
			<place placeType="shelfLocation">
			<label>5/D/4-5</label>
		</place>
		</places>
			<scopeContent>
			<p>The papers document Donald C. Stone's work with Ornstein and Swencionis on the est Outcome Project, and the development of his doctoral research, including his various publications on the human potential movement, up to the completion of his doctoral dissertation.</p>
		</scopeContent>
			[...]
		</archDesc>]]>
		</egXML>
	</div>
</div>

<?xml version="1.0" encoding="UTF-8"?>
<div type="attributeDocumentation" xml:id="attr-formAvailableType" xmlns:ead="https://archivists.org/ns/ead/v4" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:xlink="http://www.w3c.org/1999/xlink">
	<head>
		<att>formAvailableType</att>
	</head>
	<div type="fullName">
		<p>Form Available Type</p>
	</div>
	<div type="summary">
		<p>An optional attribute of <gi>formAvailable</gi> that specifies the type of form or instantiation being described.</p>
	</div>
	<div type="description">
		<p>Use <att>formAvailableType</att> with <gi>formAvailable</gi> to specify the type of form or instantiation being described.</p>
		<p>Use the attribute <att>formAvailableTypeEncoding</att> in <gi>control</gi> to identify the list of authoritative terms that can be used as values of <att>formAvailableType</att>.</p>
	</div>
	<div type="datatype">
		<p>token</p>
	</div>

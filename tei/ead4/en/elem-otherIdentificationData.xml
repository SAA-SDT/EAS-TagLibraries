<?xml version="1.0" encoding="UTF-8"?>
<div xmlns:ead="https://archivists.org/ns/ead/v4" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:xlink="http://www.w3c.org/1999/xlink" type="elementDocumentation" xml:id="elem-otherIdentificationData">
	<head>
		<gi>otherIdentificationData</gi>
	</head>
	<div type="fullName">
		<p>Other Identification Data</p>
	</div>
	<div type="summary">
		<p>A child element of <gi>identificationData</gi> for any details about the materials being described that are not more appropriately encoded in the other available elements.</p>
	</div>
	<div type="mayContain">
		<p><list type="gloss">
  <label>[text]</label>
  <item/>
  <label>reference</label>
  <item>0..n</item>
  <label>referringString</label>
  <item>0..n</item>
  <label>span</label>
  <item>0..n</item>
</list></p>
	</div>
	<div type="mayOccurWithin">
		<p>identificationData</p>
	</div>
	<div type="attributes">
    		<p>
        		<list type="gloss">
            			<label>audience</label>
            			<item>Optional</item>
            			<label>conventionDeclarationReference</label>
            			<item>Optional</item>
            			<label>id</label>
            			<item>Optional</item>
            			<label>languageOfElement</label>
            			<item>Optional</item>
            			<label>localType</label>
            			<item>Optional</item>
            			<label>localTypeDeclarationReference</label>
            			<item>Optional</item>
            			<label>maintenanceEventReference</label>
            			<item>Optional</item>
            			<label>scriptOfElement</label>
            			<item>Optional</item>
            			<label>sourceReference</label>
            			<item>Optional</item>
            			<label>target</label>
            			<item>Optional</item>
        		</list>
    		</p>
	</div>
	<div type="description">
		<p><gi>otherIdentificationData</gi> is for capturing short notes about the materials being described that cannot be encoded more appropriately in any of the other elements available in <gi>identificationData</gi>.</p>
	</div>
	<div type="attributeusage"><p>Use <att>localType</att> to specify the type of data being conveyed in the element.</p></div>	
	<div type="seealso">
		<p>For any more extensive or narrative information about the materials being described, for which there is no more appropriate element available, use <gi>otherDescriptiveInfo</gi> directly in <gi>archDesc</gi> or the component elements.</p>
              </div><div type="availability">
		<p>Optional, repeatable</p>
	</div>
	<div type="examples">
		<egXML xmlns="http://www.tei-c.org/ns/Examples">
			<!-- Contains examples of XML from the schema.  Tags in egXML must be prefixed with the proper namespace (e.g. <ead:unittitle> -->
		</egXML>
	</div>
</div>

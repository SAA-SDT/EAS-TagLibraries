<?xml version="1.0" encoding="UTF-8"?>
<div type="attributeDocumentation" xml:id="attr-sourceReference" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:ead="https://archivists.org/ns/ead/v4">
               <head>
                  <att>sourceReference</att>
               </head>
               <div type="fullName">
                  <p>Source Reference</p>
               </div>
               <div type="summary">
                  <p>Use <att>sourceReference</att> to provide a direct link to a <gi>source</gi>
                     element within <gi>sources</gi> in <gi>control</gi> from an element within the
                     EAS instance that uses the source. 
                  </p>
               </div>
               <div type="description">
                  <p>The attribute can be used to reference any detailed information about the described entity with a source.</p>
                  <p>The attribute is optionally available in elements which can contain text.</p>
               </div>
               <div type="datatype">
                  <p>IDREFS</p>
               </div>
               <div type="examples">
               </div>
            </div>

<?xml version="1.0" encoding="UTF-8"?>
<div type="attributeDocumentation" xml:id="attr-standardDate" xmlns:eac="http://archivists.org/ns/eac/v2" xmlns="http://www.tei-c.org/ns/1.0" xmlns:ead="https://archivists.org/ns/ead/v4">
               <head>
                  <att>standardDate</att>
               </head>
               <div type="fullName">
                  <p>Standard Date</p>
               </div>
               <div type="summary">
                  <p>The standardized form of date.</p>
               </div>
               <div type="description">
                  <p>The standardized form of date expressed in <gi>date</gi>, <gi>fromDate</gi>, and <gi>toDate</gi>. It is recommended that <att>standardDate</att> values follow ISO 8601, for example, 2011-07-22, 1963, or 1912-11, or another standard date format as specified in <att>dateEncoding</att>.</p>
               </div>
               <div type="datatype">
                  <p>token</p>
               </div>
               <div type="examples">
		       <p type="ead">See <gi>archDesc</gi> and <gi>identificationData</gi> encoding</p>               </div>
            </div>

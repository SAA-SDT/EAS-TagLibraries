    <head>
        <gi>description</gi>
    </head>
    <div type="fullName">
        <p>Description</p>
    </div>
    <div type="summary">
        <p type="eac">An optional child element of <gi>cpfDescription</gi>, <gi>description</gi> is a wrapper
         element for all of the content elements comprising descriptive information about the CPF
         entity.</p>
        <p type="eaf">An optional child element of <gi>functionDescription</gi>, <gi>description</gi> is a wrapper
         element for all of the content elements comprising descriptive information about the function.</p>
    </div>
